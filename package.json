{
	"name": "geokit",
	"displayName": "GeoKit (Community)",
	"description": "View GeoTIFF raster files with support for LZW, DEFLATE, and other compressions",
	"version": "0.2.0",
	"publisher": "pmembari",
	"license": "MIT",
	"icon": "assets/icon.png",
	"files": [
		"out/extension.js",
		"media/vscode-host.js",
		"media/viewer.js",
		"media/viewer.css",
		"assets/icon.png",
		"README.md",
		"CHANGELOG.md",
		"LICENSE*"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/pmembari/GeoKit"
	},
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Visualization",
		"Other"
	],
	"keywords": [
		"geotiff",
		"tiff",
		"raster",
		"remote sensing",
		"satellite",
		"ECOSTRESS",
		"COG"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"customEditors": [
			{
				"viewType": "geotiffViewer.raster",
				"displayName": "GeoKit (Community)",
				"selector": [
					{
						"filenamePattern": "*.tif"
					},
					{
						"filenamePattern": "*.tiff"
					},
					{
						"filenamePattern": "*.geotiff"
					}
				],
				"priority": "default"
			}
		],
		"configuration": {
			"title": "GeoKit (Community)",
			"properties": {
				"geotiffViewer.defaultColormap": {
					"type": "string",
					"default": "viridis",
					"enum": [
						"viridis",
						"plasma",
						"inferno",
						"magma",
						"grayscale",
						"jet",
						"terrain",
						"coolwarm"
					],
					"description": "Default colormap for displaying raster data"
				},
				"geotiffViewer.stretchPercent": {
					"type": "number",
					"default": 2,
					"minimum": 0,
					"maximum": 10,
					"description": "Percent clip for histogram stretch (applied to both ends)"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run build",
		"build": "node esbuild.config.mjs && node --check media/vscode-host.js && node --check media/viewer.js",
		"compile": "npm run build",
		"typecheck": "tsc --noEmit",
		"package": "vsce package --no-dependencies --no-yarn"
	},
	"dependencies": {
		"geotiff": "^2.1.3"
	},
	"devDependencies": {
		"@types/node": "^18.19.0",
		"@types/vscode": "^1.80.0",
		"@vscode/vsce": "^4.0.0",
		"esbuild": "^0.28.2",
		"typescript": "^5.3.0"
	}
}
